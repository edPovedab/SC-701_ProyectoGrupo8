@{
    ViewData["Title"] = "Inicio";
}

<section class="front-page-hero">
    <div class="row gy-4">
        <div class="col-lg-8">
            <div class="lead-story-kicker">
                <span class="wire-tag-dot"></span> Nota principal
            </div>
            <h1 class="lead-story-headline mb-3">
                Agrega, lee y guarda noticias de múltiples fuentes en un solo lugar
            </h1>
            <p class="lead-story-deck mb-4">
                News8 centraliza fuentes JSON y permite leerlas en vivo,
                guardar los ítems que interesan y exportarlos e importarlos como archivos JSON.
            </p>
            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="Sources" asp-action="Index" class="btn btn-primary btn-lg">Ver fuentes</a>
                <a asp-controller="Sources" asp-action="Upload" class="btn btn-outline-primary btn-lg">Subir JSON</a>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="edition-sidebar">
                <div class="edition-sidebar-title">En esta edición</div>

                <div class="wire-brief">
                    <div class="wire-brief-icon">&#128225;</div>
                    <div>
                        <div class="wire-brief-title">Múltiples formatos</div>
                        <p class="wire-brief-text">La API interpreta cada fuente con el lector correspondiente (JSON, XML o HTML).</p>
                    </div>
                </div>

                <div class="wire-brief">
                    <div class="wire-brief-icon">&#9889;</div>
                    <div>
                        <div class="wire-brief-title">Lectura en vivo</div>
                        <p class="wire-brief-text">Consulta una fuente en tiempo real antes de decidir qué ítems guardar en la base de datos.</p>
                    </div>
                </div>

                <div class="wire-brief">
                    <div class="wire-brief-icon">&#128190;</div>
                    <div>
                        <div class="wire-brief-title">Exportar / Importar</div>
                        <p class="wire-brief-text">Descarga una fuente y sus ítems como JSON, o súbelos de vuelta más tarde.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="card bg-light border-0 mt-4">
    <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <div class="wire-tag mb-1"><span class="wire-tag-dot"></span> Siguiente paso</div>
            <h2 class="h5 mb-0">Explora las fuentes registradas</h2>
        </div>
        <a asp-controller="Sources" asp-action="Index" class="btn btn-primary">Empezar &rarr;</a>
    </div>
</div>